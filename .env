# MySQL
MYSQL_DSN=mysql:host=mysql;dbname=testdb;charset=utf8mb4
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=testdb

# PostgreSQL
PGSQL_DSN=pgsql:host=postgres;dbname=testdb
PGSQL_USER=postgres
PGSQL_PASSWORD=postgres
POSTGRES_DB=testdb

# SQLite
SQLITE_DSN=sqlite::memory:
