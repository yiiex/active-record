{
    "name": "yii1x/active-record",
    "description": "Yii 1.1 Active Record, extracted and modernized for PHP 8.4+",
    "license": "BSD-3-Clause",
    "autoload": {
        "psr-4": {
            "Yii1x\\ActiveRecord\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "yii1x/validator": "^0.1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "symfony/console": "Required for migrate command (up/down/make/etc)"
    }
}
