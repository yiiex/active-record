{
    "name": "yii1x/active-record",
    "description": "Active Record",
    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "Yii1x\\ActiveRecord\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Galtsev Timofey"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "require": {
        "php": "^8.4",
        "yii1x/validator": "^0.1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "suggest": {
        "symfony/console": "Required for migrate command (up/down/make/etc)"
    }
}
